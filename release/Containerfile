# Static musl binaries run on glibc and musl distributions.
# Install the current stable Rust toolchain through the standard Rustup installer.
FROM docker.io/library/ubuntu:stonking-20261023.1@sha256:c99db7323621802852e277a697aba0a09e44b30f3258d5b51dfc97d380b65e7e
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl gcc libc6-dev binutils \
 && rm -rf /var/lib/apt/lists/*
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo
RUN curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs -o /tmp/rustup-init.sh \
 && sh /tmp/rustup-init.sh -y --profile minimal --default-toolchain stable --no-modify-path \
 && /opt/cargo/bin/rustup target add x86_64-unknown-linux-musl \
 && rm /tmp/rustup-init.sh
ENTRYPOINT []
ENV PATH=/opt/cargo/bin:/usr/bin:/bin LC_ALL=C TZ=UTC
RUN mkdir /builder && rustc -vV > /builder/rustc.txt && cargo -vV > /builder/cargo.txt \
 && rustup target list --installed > /builder/targets.txt && cc --version | head -n 1 > /builder/cc.txt \
 && ld --version | head -n 1 > /builder/ld.txt
WORKDIR /source
