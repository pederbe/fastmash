# The glibc 2.28 build environment preserves Linux runtime compatibility.
# Install the current stable Rust toolchain through the standard Rustup installer.
FROM quay.io/pypa/manylinux_2_28_x86_64@sha256:ae830e2ecbf4568743f8b760920cd7483538375b6b242a9fb02b5b2ad0245f68
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo
RUN curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs -o /tmp/rustup-init.sh \
 && sh /tmp/rustup-init.sh -y --profile minimal --default-toolchain stable --no-modify-path \
 && rm /tmp/rustup-init.sh
# Keep the static unwind library and the existing Linux runtime checks.
RUN test -f /opt/rh/gcc-toolset-14/root/usr/lib/gcc/x86_64-redhat-linux/14/libgcc_eh.a \
 && mkdir /opt/fastmash-link \
 && ln -s /opt/rh/gcc-toolset-14/root/usr/lib/gcc/x86_64-redhat-linux/14/libgcc_eh.a /opt/fastmash-link/libgcc_s.a
ENTRYPOINT []
ENV PATH=/opt/cargo/bin:/opt/rh/gcc-toolset-14/root/usr/bin:/usr/bin:/bin LC_ALL=C TZ=UTC
RUN mkdir /builder && rustc -vV > /builder/rustc.txt && cargo -vV > /builder/cargo.txt \
 && ldd --version | head -n 1 > /builder/glibc.txt && cc --version | head -n 1 > /builder/cc.txt \
 && ld --version | head -n 1 > /builder/ld.txt
WORKDIR /source
