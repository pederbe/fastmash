# Maintainer: Peder Bergan <https://github.com/pederbe/fastmash/issues>
#
# Installs the published Linux executable without rebuilding or stripping it.
# See README.md for local installation and release updates.
pkgname=fastmash-bin
pkgver=0.5.0
pkgrel=1
pkgdesc="Fast command-line statistics and table transformations"
arch=('x86_64')
url="https://fastmash.io"
license=('MIT OR Apache-2.0')
depends=('glibc')
provides=("fastmash=${pkgver}")
conflicts=('fastmash')
options=('!strip' '!debug')
_name="fastmash-v${pkgver}-x86_64-unknown-linux-gnu"
source=("https://github.com/pederbe/fastmash/releases/download/v${pkgver}/${_name}.tar.gz")
sha256sums=('a796427f78c42f6f925c4cbf1ab5b3b9a83b1f204f06b9e457c8c165a3b3b64a')

check() {
  local output
  cd "${_name}" || return
  output=$(./fastmash --version) || return
  test "$output" = "fastmash ${pkgver}" || return
  output=$(printf '1\n2\n' | ./fastmash sum 1) || return
  test "$output" = '3'
}

package() {
  cd "${_name}" || return
  install -Dm755 fastmash -t "${pkgdir}/usr/bin/"
  install -Dm644 README.md CHANGELOG.md -t "${pkgdir}/usr/share/doc/fastmash/"
  install -Dm644 LICENSE-MIT LICENSE-APACHE THIRD-PARTY-LICENSES.md \
    -t "${pkgdir}/usr/share/licenses/${pkgname}/"
}
